class _UpstreamPool:
    """Simple HTTPS connection pool keyed by (host, port).

    Reuses persistent connections (HTTP keep-alive) so multiple API
    requests share the same TLS session.  This avoids per-request TLS
    handshakes that trigger aggressive rate limiting on some providers.
    """

    def __init__(self):
        self._conns: dict[tuple[str, int], http.client.HTTPSConnection] = {}
        self._lock = threading.Lock()

    def request(
        self,
        url: str,
        method: str,
        body: bytes | None,
        headers: dict[str, str],
    ) -> http.client.HTTPResponse:
        parsed = urlparse(url)
        host = parsed.hostname or ""
        port = parsed.port or 443
        path = parsed.path
        if parsed.query:
            path = f"{path}?{parsed.query}"

        key = (host, port)
        with self._lock:
            conn = self._conns.get(key)
            if conn is None:
                conn = http.client.HTTPSConnection(host, port)
                self._conns[key] = conn

        try:
            conn.request(method, path, body=body, headers=headers)
            return conn.getresponse()
        except (http.client.HTTPException, OSError):
            # Stale connection — reconnect once.
            conn = http.client.HTTPSConnection(host, port)
            with self._lock:
                self._conns[key] = conn
            conn.request(method, path, body=body, headers=headers)
            return conn.getresponse()


# Module-level singleton so all handler instances share connections.
_upstream_pool = _UpstreamPool()


class _ProxyRequestHandler(BaseHTTPRequestHandler):
    """HTTP handler for the credential-injecting reverse proxy.

    Handles two modes:

    - Reverse proxy: requests to ``/`` are forwarded to a configured upstream
      API domain with credential headers injected.  The client sets
      ``*_BASE_URL=http://127.0.0.1:PORT`` so its SDK sends plain HTTP to us.
    - CONNECT tunneling: for general HTTPS traffic (package managers, git).
      Passes through without credential injection.

    Blocked hosts (cloud metadata endpoints) are rejected outright.
    """

    # Set by CredentialProxy before the server starts serving.
    credential_rules: list[dict] = []
    blocked_hosts: set[str] = set()
    request_count: int = 0
    _count_lock: threading.Lock = threading.Lock()

    # Silence default stderr logging — we use the logging module instead.
    def log_message(self, fmt, *log_args):
        _proxy_logger.debug("proxy: %s", fmt % log_args)

    # --- Metadata / blocked host guard ------------------------------------

    def _is_blocked(self, host: str) -> bool:
        """Return True if *host* is in the blocked set."""
        bare = host.split(":")[0]
        return bare in self.blocked_hosts

    def _find_rule_for_host(self, host: str) -> dict | None:
        """Return the credential rule matching *host*, or None."""
        bare = host.split(":")[0]
        for rule in self.credential_rules:
            if rule["domain"] == bare:
                return rule
        return None

    # --- Request counting -------------------------------------------------

    @classmethod
    def _bump_count(cls):
        with cls._count_lock:
            cls.request_count += 1

    # --- CONNECT handling (tunnel pass-through) ---------------------------

    def do_CONNECT(self):  # noqa: N802
        host = self.path
        if self._is_blocked(host):
            self.send_error(403, f"Blocked host: {host}")
            _proxy_logger.info("BLOCKED CONNECT to %s", host)
            return

        self._bump_count()
        _proxy_logger.debug("CONNECT tunnel to %s", host)

        # Parse host:port.
        if ":" in host:
            hostname, port_s = host.rsplit(":", 1)
            port = int(port_s)
        else:
            hostname, port = host, 443

        try:
            upstream = socket.create_connection((hostname, port), timeout=30)
        except OSError as exc:
            self.send_error(502, f"Cannot connect to {host}: {exc}")
            return

        self.send_response(200, "Connection Established")
        self.end_headers()

        # Bi-directional tunnel.
        def _forward(src, dst):
            try:
                while True:
                    data = src.recv(65536)
                    if not data:
                        break
                    dst.sendall(data)
            except OSError:
                pass
            finally:
                try:
                    dst.shutdown(socket.SHUT_WR)
                except OSError:
                    pass

        client_conn = self.connection
        t1 = threading.Thread(
            target=_forward, args=(client_conn, upstream), daemon=True
        )
        t2 = threading.Thread(
            target=_forward, args=(upstream, client_conn), daemon=True
        )
        t1.start()
        t2.start()
        t1.join()
        t2.join()
        upstream.close()

    # --- Generic forwarding for all HTTP methods --------------------------

    def _handle_forward(self, method: str):
        """Forward request to the appropriate upstream API with credentials."""
        host_header = self.headers.get("Host", "")
        if self._is_blocked(host_header):
            self.send_error(403, f"Blocked host: {host_header}")
            _proxy_logger.info("BLOCKED %s to %s", method, host_header)
            return

        rule = self._find_rule_for_host(host_header)

        # When the client SDK hits http://127.0.0.1:PORT/v1/messages the
        # Host header is 127.0.0.1:PORT — no domain match.  Fall back to
        # matching by path prefix or the single configured rule.
        if rule is None and len(self.credential_rules) == 1:
            rule = self.credential_rules[0]
        if rule is None:
            for candidate in self.credential_rules:
                base_path = candidate.get("base_path", "/")
                if self.path.startswith(base_path):
                    rule = candidate
                    break
        if rule is None:
            self.send_error(502, "No credential rule matches this request")
            return

        self._bump_count()

        # When the SDK uses HTTP_PROXY, self.path may be an absolute URL
        # like "http://127.0.0.1:PORT/v1/messages?beta=true".  Extract
        # just the path+query component for upstream construction.
        req_path = self.path
        if req_path.startswith("http://") or req_path.startswith("https://"):
            parsed = urlparse(req_path)
            req_path = parsed.path
            if parsed.query:
                req_path = f"{req_path}?{parsed.query}"

        # Use the original base URL if the profile configured one (e.g.
        # third-party API proxies like Z.ai), otherwise default to the
        # rule's domain.
        upstream_base = rule.get("upstream_base", "")
        if upstream_base:
            upstream_url = f"{upstream_base.rstrip('/')}{req_path}"
        else:
            upstream_url = f"https://{rule['domain']}{req_path}"

        content_length = int(self.headers.get("Content-Length", 0))
        body = (
            self.rfile.read(content_length) if content_length > 0 else None
        )

        # Build headers dict for the upstream request.
        fwd_headers: dict[str, str] = {}
        for hdr, val in self.headers.items():
            if hdr.lower() not in _PROXY_SKIP_HEADERS:
                fwd_headers[hdr] = val

        # Inject credential header.
        prefix = rule.get("header_prefix", "")
        fwd_headers[rule["header_name"]] = f"{prefix}{rule['header_value']}"

        _proxy_logger.info(
            "FWD %s %s -> %s",
            method, self.path, upstream_url,
        )

        try:
            # Use the connection pool for keep-alive (avoids per-request
            # TLS handshakes that trigger rate limiting on some providers).
            resp = _upstream_pool.request(
                upstream_url, method, body, fwd_headers,
            )
            self.send_response(resp.status)
            for hdr, val in resp.getheaders():
                if hdr.lower() not in _PROXY_SKIP_HEADERS:
                    self.send_header(hdr, val)
            self.end_headers()
            self.wfile.flush()
            # Stream response: use small reads and flush after each
            # write so SSE events reach the client immediately.
            while True:
                chunk = resp.read(4096)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()
        except http.client.HTTPException as exc:
            _proxy_logger.warning(
                "Upstream error %s %s: %s", method, upstream_url, exc
            )
            self.send_error(502, f"Upstream error: {exc}")
        except OSError as exc:
            _proxy_logger.error("Proxy forwarding error: %s", exc)
            self.send_error(502, f"Proxy error: {exc}")

    def do_GET(self):  # noqa: N802
        self._handle_forward("GET")

    def do_POST(self):  # noqa: N802
        self._handle_forward("POST")

    def do_PUT(self):  # noqa: N802
        self._handle_forward("PUT")

    def do_PATCH(self):  # noqa: N802
        self._handle_forward("PATCH")

    def do_DELETE(self):  # noqa: N802
        self._handle_forward("DELETE")

    def do_HEAD(self):  # noqa: N802
        self._handle_forward("HEAD")

    def do_OPTIONS(self):  # noqa: N802
        self._handle_forward("OPTIONS")


class CredentialProxy:
    """Localhost HTTP proxy that injects credentials into API requests.

    Runs on ``127.0.0.1`` with a kernel-assigned ephemeral port.  Two modes:

    - **Reverse proxy** for configured API domains: the sandboxed agent's
      ``*_BASE_URL`` env var points to ``http://127.0.0.1:<port>`` so its
      HTTP SDK sends plain-text requests to the proxy.  The proxy adds the
      secret header and forwards over HTTPS to the real API.

    - **CONNECT tunnel** for everything else: package managers, git, etc.
      can use ``HTTP_PROXY`` to route through the proxy for general
      connectivity without credential injection.

    Cloud metadata endpoints are blocked to prevent credential theft via
    SSRF-like attacks from AI agents.
    """

    def __init__(
        self,
        credential_rules: list[dict],
        blocked_hosts: set[str] | None = None,
    ):
        self._rules = credential_rules
        self._blocked = blocked_hosts or set(DEFAULT_BLOCKED_HOSTS)
        self._server: ThreadingTCPServer | None = None
        self._thread: threading.Thread | None = None
        self._port: int = 0
        self._start_time: float = 0.0
        self._pid_file = SANDBOX_DIR / "proxy.pid"

    def start(self) -> int:
        """Start the proxy server.  Returns the assigned port number."""
        _ProxyRequestHandler.credential_rules = list(self._rules)
        _ProxyRequestHandler.blocked_hosts = set(self._blocked)
        _ProxyRequestHandler.request_count = 0

        ThreadingTCPServer.allow_reuse_address = True
        ThreadingTCPServer.daemon_threads = True

        self._server = ThreadingTCPServer(
            ("127.0.0.1", 0), _ProxyRequestHandler
        )
        self._port = self._server.server_address[1]
        self._start_time = time.monotonic()

        self._thread = threading.Thread(
            target=self._server.serve_forever, daemon=True
        )
        self._thread.start()

        # Write PID file so proxy-status can find us.
        self._pid_file.parent.mkdir(parents=True, exist_ok=True)
        proxy_info = {
            "pid": os.getpid(),
            "port": self._port,
            "start_time": time.time(),
            "rules": [
                {
                    "domain": r["domain"],
                    "header_name": r["header_name"],
                    "upstream_base": r.get("upstream_base", ""),
                }
                for r in self._rules
            ],
        }
        self._pid_file.write_text(
            json.dumps(proxy_info, indent=2) + "\n"
        )

        atexit.register(self.stop)

        _proxy_logger.info(
            "Credential proxy started on 127.0.0.1:%d (%d rules)",
            self._port,
            len(self._rules),
        )
        return self._port

    def stop(self):
        """Shut down the proxy server and clean up the PID file."""
        if self._server is not None:
            self._server.shutdown()
            self._server.server_close()
            self._server = None
            _proxy_logger.info("Credential proxy stopped")
        if self._pid_file.exists():
            try:
                self._pid_file.unlink()
            except OSError:
                pass

    def is_alive(self) -> bool:
        """Return True if the proxy server thread is running."""
        return self._thread is not None and self._thread.is_alive()

    def get_port(self) -> int:
        """Return the port the proxy is listening on."""
        return self._port

    def get_request_count(self) -> int:
        """Return the number of requests handled so far."""
        return _ProxyRequestHandler.request_count

    def uptime_seconds(self) -> float:
        """Return how long the proxy has been running."""
        if self._start_time:
            return time.monotonic() - self._start_time
        return 0.0


def _collect_proxy_rules(env_vars: dict[str, str]) -> tuple[list[dict], list[str]]:
    """Build credential proxy rules from resolved environment variables.

    Scans *env_vars* for keys matching ``CREDENTIAL_PROXY_RULES`` and
    returns ``(rules, strip_vars)`` — a list of rule dicts ready for
    ``CredentialProxy`` and a list of **all** env var names that must be
    stripped from the sandbox (even when two vars map to the same domain
    and only one proxy rule is created, e.g. ANTHROPIC_API_KEY and
    ANTHROPIC_AUTH_TOKEN both target api.anthropic.com).
    """
    rules: list[dict] = []
    strip_vars: list[str] = []
    seen_domains: set[str] = set()
    for env_key, rule_tpl in CREDENTIAL_PROXY_RULES.items():
        value = env_vars.get(env_key)
        if not value:
            continue
        # Always strip the env var from the sandbox.
        strip_vars.append(env_key)
        # Register at most one proxy rule per domain (first match wins).
        if rule_tpl["domain"] not in seen_domains:
            # Capture the original base URL (if the user set one, e.g.
            # for third-party proxies like Z.ai) so the proxy forwards
            # to the correct upstream instead of the default domain.
            original_base = env_vars.get(rule_tpl["base_url_env"], "")
            rules.append({
                "domain": rule_tpl["domain"],
                "header_name": rule_tpl["header_name"],
                "header_prefix": rule_tpl.get("header_prefix", ""),
                "header_value": value,
                "env_var": env_key,
                "base_url_env": rule_tpl["base_url_env"],
                "upstream_base": original_base,
            })
            seen_domains.add(rule_tpl["domain"])
    return rules, strip_vars



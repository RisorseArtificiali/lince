def cmd_init(args) -> None:
    print("Initializing agent-sandbox...\n")

    # Determine use_real_config: --real-config flag or existing config setting
    use_real_config = getattr(args, "real_config", False)
    if not use_real_config:
        try:
            old_stderr = sys.stderr
            sys.stderr = io.StringIO()
            try:
                config_path = find_config()
            finally:
                sys.stderr = old_stderr
            with open(config_path, "rb") as fh:
                existing_config = tomllib.load(fh)
            use_real_config = existing_config.get("claude", {}).get(
                "use_real_config", False
            )
        except SystemExit:
            pass

    # Directory structure
    dirs = [
        SANDBOX_DIR,
        SANDBOX_DIR / "toolchains" / "cargo",
        SANDBOX_DIR / "toolchains" / "npm-cache",
        SANDBOX_DIR / "toolchains" / "go",
        SANDBOX_DIR / "toolchains" / "uv-cache",
        SANDBOX_DIR / "toolchains" / "uv-tools",
        SANDBOX_DIR / "bin",
        SANDBOX_DIR / "logs",
    ]
    if not use_real_config:
        dirs.append(SANDBOX_DIR / "claude-config")
    for d in dirs:
        d.mkdir(parents=True, exist_ok=True)

    if use_real_config:
        # Skip copy — will mount real ~/.claude directly
        print(f"  claude-config using real ~/.claude (use_real_config = true)")
        print(f"  claude.json   using real ~/.claude.json (use_real_config = true)")
    else:
        # Copy Claude config
        src = Path.home() / ".claude"
        dst = SANDBOX_DIR / "claude-config"
        if src.exists():
            if args.force or not any(dst.iterdir()):
                for item in list(dst.iterdir()):
                    if item.is_dir():
                        shutil.rmtree(item)
                    else:
                        item.unlink()
                shutil.copytree(src, dst, dirs_exist_ok=True, ignore_dangling_symlinks=True)
                print(f"  claude-config {src} -> {dst}")
                # Check for secrets in settings.json
                settings = dst / "settings.json"
                if settings.exists() and "SECRET" in settings.read_text().upper():
                    print("\n  WARNING: settings.json may contain secrets "
                          "(MCP server env vars).")
                    print("  Review: " + str(settings))
            else:
                print(f"  claude-config (exists, use --force)")
        else:
            print(f"  claude-config ~/.claude not found, starting empty")

        # Copy Claude runtime state file (~/.claude.json)
        claude_json_src = Path.home() / ".claude.json"
        claude_json_dst = SANDBOX_DIR / "claude.json"
        if claude_json_src.exists():
            if args.force or not claude_json_dst.exists():
                shutil.copy2(claude_json_src, claude_json_dst)
                print(f"  claude.json   {claude_json_src} -> {claude_json_dst}")
            else:
                print(f"  claude.json   (exists, use --force)")
        else:
            print(f"  claude.json   ~/.claude.json not found, skipping")

    # Sanitise gitconfig — use config from file if available, else defaults
    git_src = Path.home() / ".gitconfig"
    if not git_src.exists():
        git_src = Path.home() / ".config" / "git" / "config"
    try:
        old_stderr = sys.stderr
        sys.stderr = io.StringIO()
        try:
            config_path = find_config()
        finally:
            sys.stderr = old_stderr
        with open(config_path, "rb") as fh:
            config = tomllib.load(fh)
    except SystemExit:
        config = {}
    git_conf = config.get("git", {})
    sanitize_gitconfig(
        git_src,
        SANDBOX_DIR / "gitconfig",
        git_conf.get("strip_sections", ["credential", 'url ".*"']),
        git_conf.get("overrides", {"push.default": "nothing"}),
    )
    print(f"  gitconfig     {SANDBOX_DIR / 'gitconfig'}")

    # Copy agents-defaults.toml into SANDBOX_DIR so it is found at search path #2
    agents_defaults_src = Path(__file__).resolve().parent / "agents-defaults.toml"
    agents_defaults_dst = SANDBOX_DIR / "agents-defaults.toml"
    if agents_defaults_src.is_file():
        shutil.copy2(agents_defaults_src, agents_defaults_dst)
        print(f"  agents-defaults {agents_defaults_dst}")

    # Git-push wrapper
    ensure_git_wrapper()
    print(f"  git wrapper   {SANDBOX_DIR / 'bin' / 'git'}")

    # Auto-detected PATH dirs
    home_dirs = detect_home_path_dirs()
    home_entries = detect_home_path_entries()
    if home_dirs:
        print(f"\n  Auto-detected PATH dirs under $HOME ({len(home_dirs)}):")
        for d in home_dirs:
            # Show deep PATH entries under this top-level dir
            deep = [e for e in home_entries if e != d and str(e).startswith(str(d) + "/")]
            print(f"    ro  {d}")
            for de in deep:
                print(f"        + {de}  (deep PATH entry)")

    # Create default config.toml if none exists
    config_created = False
    try:
        old_stderr = sys.stderr
        sys.stderr = io.StringIO()
        try:
            cp = find_config()
        finally:
            sys.stderr = old_stderr
        print(f"\nUsing config:\n  {cp}\n")
    except SystemExit:
        default_cfg = SANDBOX_DIR / "config.toml"
        default_cfg.write_text(_DEFAULT_CONFIG)
        print(f"\n  config.toml   created {default_cfg}")
        config_created = True

    if config_created:
        print(f"\nEdit {SANDBOX_DIR / 'config.toml'} to configure profiles and API keys.\n")

    print("Run Claude in sandbox:\n  agent-sandbox run\n")


def cmd_run(args, agent_extra: list[str]) -> None:
    config, config_path = load_config()
    backend = resolve_backend(config)

    project_dir = Path(args.project).resolve()
    if not project_dir.is_dir():
        print(f"Error: not a directory: {project_dir}", file=sys.stderr)
        sys.exit(1)

    # Resolve agent configuration
    agent_name = args.agent
    agent_cfg = resolve_agent_config(config, agent_name)

    # Ensure git wrapper exists (only needed for bwrap backend)
    if backend == "agent-sandbox" and config.get("security", {}).get("block_git_push", True):
        ensure_git_wrapper()

    # Logging
    log_conf = config.get("logging", {})
    do_log = args.log if args.log is not None else log_conf.get("enabled", False)
    log_file = None
    if do_log:
        log_dir = expand(log_conf.get("dir", "~/.agent-sandbox/logs"))
        log_dir.mkdir(parents=True, exist_ok=True)
        ts = datetime.now().strftime("%Y-%m-%d_%H%M%S")
        log_file = log_dir / f"{ts}_{project_dir.name}.log"

    # Resolve profile: explicit -P flag > default_profile from config
    profile = args.profile
    from_default = False
    if profile is None:
        profile = config.get("sandbox", {}).get("default_profile", "") or None
        from_default = True
    prof_desc = None
    if profile:
        profiles = resolve_profiles(config, agent_name)
        if profile not in profiles:
            if from_default:
                # default_profile doesn't exist for this agent type — silently skip
                profile = None
            else:
                # Explicit -P flag: hard error
                avail = ", ".join(sorted(profiles)) if profiles else "(none defined)"
                print(f"Error: unknown profile '{profile}'.", file=sys.stderr)
                print(f"Available profiles: {avail}", file=sys.stderr)
                sys.exit(1)
        prof_data = profiles[profile]
        prof_desc = (prof_data.get("meta", {}).get("description", "") or prof_data.get("description", "")) if isinstance(prof_data, dict) else ""

    sec = config.get("security", {})

    # --- nono backend path (simpler — nono handles isolation itself) -------
    if backend == "nono":
        # Pre-create writable home dirs so they exist before Landlock
        # restricts the parent directory.  Without this, agents that need
        # writable config dirs (e.g. ~/.gemini) fail with EACCES.
        for d in agent_cfg.get("home_rw_dirs", []):
            (Path.home() / d).mkdir(parents=True, exist_ok=True)

        # Ensure nono profile exists
        nono_profile_file = NONO_PROFILE_DIR / f"lince-{agent_name}.json"
        if not nono_profile_file.exists():
            print(f"nono profile not found: {nono_profile_file}", file=sys.stderr)
            print("Run 'agent-sandbox nono-sync' to generate profiles.", file=sys.stderr)
            sys.exit(1)

        cmd = build_nono_cmd(
            agent_name, project_dir, agent_cfg, agent_extra,
            safe_mode=args.safe, agent_id=args.id,
            nono_path=shutil.which("nono") or "nono",
        )

        if args.dry_run:
            print("# nono command that would be executed:\n")
            print(f"# config: {config_path}")
            print(f"# agent: {agent_name} ({agent_cfg['command']})")
            print(f"# profile: lince-{agent_name}")
            if profile:
                print(f"# provider: {profile}")
            _pretty_print_cmd(cmd)
            return

        # Print banner
        print("agent-sandbox (nono backend)")
        print(f"  config      {config_path}")
        print(f"  backend     nono ({shutil.which('nono')})")
        print(f"  agent       {agent_name} ({agent_cfg['command']})")
        print(f"  nono prof   lince-{agent_name}")
        if profile:
            desc = f" ({prof_desc})" if prof_desc else ""
            print(f"  profile     {profile}{desc}")
        print(f"  project     {project_dir}")
        print(f"  isolation   Landlock LSM / Seatbelt")
        print(f"  network     enabled")
        git_push_status = "soft-blocked (git config)" if sec.get("block_git_push", True) else "allowed"
        print(f"  git push    {git_push_status}")
        print(
            f"  permissions "
            f"{'ask (safe mode)' if args.safe else 'per agent defaults'}"
        )
        print()

        # Inject provider profile env vars into the subprocess environment so
        # nono's allow_vars can pass them through into the sandbox.  Values
        # defined in [<agent>.profiles.<name>.env] are config-time constants
        # (not host-shell vars), so nono would drop them without this.
        nono_env = dict(os.environ)
        if profile:
            all_profiles = resolve_profiles(config, agent_name)
            prof_data = all_profiles.get(profile, {})
            if isinstance(prof_data, dict):
                env_unset: list[str] = []
                for var, val in prof_data.get("env", {}).items():
                    if var == "env_unset":
                        env_unset = list(val) if isinstance(val, list) else []
                    else:
                        nono_env[var] = str(val)
                for var in env_unset:
                    nono_env.pop(var, None)
        if args.id:
            nono_env["LINCE_AGENT_ID"] = args.id
        nono_env["HOME"] = str(SANDBOX_HOME)
        # nono derives its profile dir from $XDG_CONFIG_HOME (falls back to $HOME/.config);
        # pin it explicitly so nono still finds profiles after HOME is overridden.
        nono_env.setdefault("XDG_CONFIG_HOME", str(Path.home() / ".config"))
        # Synthetic PATH: $HOME/.local/bin (fake home, satisfies Claude's PATH check)
        # + real agent binary dirs + standard system dirs.  Not the host PATH.
        agent_command = agent_cfg.get("command", agent_name)
        agent_bin = shutil.which(agent_command)
        bin_dirs: list[str] = [str(SANDBOX_HOME / ".local" / "bin")]
        if agent_bin:
            for p in {Path(agent_bin).parent, Path(agent_bin).resolve().parent}:
                s = str(p)
                if s not in bin_dirs:
                    bin_dirs.append(s)
        # Include node bin so npx-based MCP servers (e.g. context7) can start.
        # detect_node_bin_dir() returns the installation root for fnm (bin/ is a subdir)
        # or the bin/ directory directly for nvm/Homebrew/system installs.
        node_dir = detect_node_bin_dir()
        if node_dir:
            node_bin = str(node_dir / "bin") if (node_dir / "bin").is_dir() else str(node_dir)
            if node_bin not in bin_dirs:
                bin_dirs.append(node_bin)
        nono_env["PATH"] = ":".join(bin_dirs + ["/usr/local/bin", "/usr/bin", "/bin"])
        nono_env["NPM_CONFIG_CACHE"] = str(SANDBOX_DIR / "toolchains" / "npm-cache")
        nono_env["CLAUDE_CONFIG_DIR"] = str(SANDBOX_DIR / "claude-config")
        if agent_name == "claude":
            nono_env["CLOUDSDK_CONFIG"] = str(Path.home() / ".config" / "gcloud")
            adc_file = Path.home() / ".config" / "gcloud" / "application_default_credentials.json"
            if adc_file.exists():
                nono_env["GOOGLE_APPLICATION_CREDENTIALS"] = str(adc_file)

        try:
            result = subprocess.run(cmd, cwd=str(project_dir), env=nono_env)
            sys.exit(result.returncode)
        except KeyboardInterrupt:
            print("\nSandbox terminated.")
        except FileNotFoundError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            sys.exit(1)
        return

    # --- agent-sandbox (bwrap) backend path --------------------------------

    # --- Credential proxy setup -------------------------------------------
    proxy_enabled = sec.get("credential_proxy", False)
    proxy: CredentialProxy | None = None
    proxy_env: dict[str, str] = {}

    if proxy_enabled:
        # Collect all env vars that will be visible inside the sandbox so
        # we can scan for API keys.  Merge order matches build_bwrap_cmd.
        collected_env: dict[str, str] = {}
        env_conf = config.get("env", {})
        for var, val in env_conf.get("extra", {}).items():
            collected_env[var] = str(val)
        if profile:
            all_profiles = resolve_profiles(config, agent_name)
            prof_data = all_profiles.get(profile, {})
            for var, val in prof_data.get("env", {}).items():
                if var != "env_unset":
                    collected_env[var] = str(val)
        for var, val in agent_cfg.get("env", {}).items():
            collected_env[var] = str(val)

        rules, strip_vars = _collect_proxy_rules(collected_env)
        if rules:
            proxy_conf = config.get("credential_proxy", {})
            blocked = set(
                proxy_conf.get("blocked_hosts", DEFAULT_BLOCKED_HOSTS)
            )
            proxy = CredentialProxy(rules, blocked_hosts=blocked)
            port = proxy.start()

            # Build env overrides: remove API keys, rewrite base URLs,
            # set HTTP_PROXY for general CONNECT tunneling.
            proxy_base = f"http://127.0.0.1:{port}"
            # Strip ALL credential env vars (not just those with a proxy
            # rule — two vars can share a domain, e.g. ANTHROPIC_API_KEY
            # and ANTHROPIC_AUTH_TOKEN).
            for var in strip_vars:
                proxy_env[var] = ""
            for rule in rules:
                # Rewrite the base URL so the SDK talks to our proxy.
                proxy_env[rule["base_url_env"]] = proxy_base
            proxy_env["HTTP_PROXY"] = proxy_base
            proxy_env["http_proxy"] = proxy_base

    # Build command
    cmd = build_bwrap_cmd(config, project_dir, agent_extra, log_file,
                          profile=profile, safe_mode=args.safe,
                          extra_rw_cli=args.rw, extra_ro_cli=args.ro,
                          agent_config=agent_cfg, agent_id=args.id,
                          agent_name=agent_name,
                          proxy_env=proxy_env if proxy_env else None)

    if args.dry_run:
        print("# bwrap command that would be executed:\n")
        print(f"# config: {config_path}")
        print(f"# agent: {agent_name} ({agent_cfg['command']})")
        if profile:
            print(f"# profile: {profile}")
        if proxy:
            print(f"# credential proxy: 127.0.0.1:{proxy.get_port()}")
        _pretty_print_cmd(cmd)
        if proxy:
            proxy.stop()
        return

    # Print banner
    use_real = config.get("claude", {}).get("use_real_config", False)
    print("agent-sandbox")
    print(f"  config      {config_path}")
    print(f"  backend     agent-sandbox (bubblewrap)")
    print(f"  agent       {agent_name} ({agent_cfg['command']})")
    if profile:
        desc = f" ({prof_desc})" if prof_desc else ""
        print(f"  profile     {profile}{desc}")
    if use_real:
        print(f"  agent-cfg   real ~/.claude (use_real_config)")
    else:
        cc_dir = expand(config.get("claude", {}).get("config_dir",
                        "~/.agent-sandbox/claude-config"))
        print(f"  agent-cfg   {cc_dir} (isolated copy)")
    print(f"  project     {project_dir}")
    print(f"  filesystem  read-only root, writable project dir")
    print(f"  network     enabled")
    print(f"  pid isolat. {'on' if sec.get('unshare_pid', True) else 'off'}")
    print(f"  git push    {'blocked' if sec.get('block_git_push', True) else 'allowed'}")
    print(f"  env vars    clearenv + whitelist")
    if proxy:
        targets = [
            r.get("upstream_base") or r["domain"] for r in proxy._rules
        ]
        print(f"  cred proxy  127.0.0.1:{proxy.get_port()} -> {', '.join(targets)}")
    else:
        cred_label = "disabled" if not proxy_enabled else "no matching keys"
        print(f"  cred proxy  {cred_label}")
    if agent_cfg.get("bwrap_conflict"):
        print(
            f"  bwrap fix   inner sandbox disabled via "
            f"{agent_cfg.get('disable_inner_sandbox_args', [])}"
        )
    print(f"  permissions {'ask (safe mode)' if args.safe else 'per agent defaults'}")
    if args.rw:
        print(f"  extra rw    {', '.join(args.rw)}")
    if args.ro:
        print(f"  extra ro    {', '.join(args.ro)}")
    if log_file:
        print(f"  logging     {log_file}")

    # Auto-snapshot before launch
    _auto_snapshot(config, project_dir, agent_name)

    print()

    try:
        result = subprocess.run(cmd, cwd=str(project_dir))
        snap_conf = _get_snapshot_config(config)
        if snap_conf["auto_config"] or snap_conf["auto_project"]:
            print(
                "\nTip: run 'agent-sandbox snapshot-diff' to see "
                "what changed since the pre-run snapshot.",
            )
        sys.exit(result.returncode)
    except KeyboardInterrupt:
        print("\nSandbox terminated.")
    except FileNotFoundError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        sys.exit(1)
    finally:
        if proxy:
            proxy.stop()


def cmd_diff(args) -> None:
    try:
        config, _ = load_config()
    except SystemExit:
        config = {}
    if config.get("claude", {}).get("use_real_config", False):
        print("diff disabled: using real ~/.claude (use_real_config = true)")
        return

    real = Path.home() / ".claude"
    sand = SANDBOX_DIR / "claude-config"
    if not real.exists():
        print("No ~/.claude found."); return
    if not sand.exists():
        print("No sandbox config. Run 'agent-sandbox init'."); return

    diff_results = compute_dir_diff(real, sand)
    has_diff = print_dir_diff(diff_results, source_label="real", target_label="sandbox")
    if not has_diff:
        print("No differences.")


def cmd_merge(args) -> None:
    try:
        config, _ = load_config()
    except SystemExit:
        config = {}
    if config.get("claude", {}).get("use_real_config", False):
        print("merge disabled: using real ~/.claude (use_real_config = true)")
        return

    real = Path.home() / ".claude"
    sand = SANDBOX_DIR / "claude-config"
    if not sand.exists():
        print("No sandbox config. Run 'agent-sandbox init'."); return

    diff_results = compute_dir_diff(real, sand)
    changed = [r for r in diff_results if r[1] != "unchanged"]
    if not changed:
        print("No changes to merge."); return

    decisions = interactive_review(diff_results, real, sand, action_verb="apply")
    applied = apply_diff_actions(decisions, real, sand)
    total = sum(1 for _, d in decisions if d == "accept")
    print(f"\nMerge complete: {applied}/{len(changed)} file(s) applied.")



#!/usr/bin/env bash
#
# LINCE Installer — thin wrapper
# https://lince.sh
#
# Usage:
#   curl -sSL https://lince.sh/install | bash                    (interactive)
#   curl -sSL https://lince.sh/install | bash -s -- --defaults   (non-interactive, sane defaults)
#
# This script:
#   1. Prints banner and detects OS
#   2. Checks core prerequisites and provisions Python/Zellij when needed
#   3. Clones the lince repo to ~/.local/share/lince/bootstrap-source
#   4. Delegates everything else to quickstart.sh
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

BUILD_FROM_SOURCE=false
USE_DEFAULTS=false
for arg in "$@"; do
  case "$arg" in
    --build-from-source) BUILD_FROM_SOURCE=true ;;
    --defaults) USE_DEFAULTS=true ;;
  esac
done

# Prefer user-local tools provisioned by this bootstrap.
export PATH="$HOME/.local/bin:$PATH"

echo ""
echo -e "${CYAN}${BOLD}"
echo "  ╦  ╦╔╗╔╔═╗╔═╗"
echo "  ║  ║║║║║  ║╣ "
echo "  ╩═╝╩╝╚╝╚═╝╚═╝"
echo -e "${NC}"
echo -e "  ${BOLD}Secure Multi-Agent Coding Workstation${NC}"
echo -e "  https://lince.sh"
echo ""

# ── OS Detection ─────────────────────────────────────────────────────
OS_NAME="$(uname -s)"
ARCH="$(uname -m)"

case "$OS_NAME" in
  Linux)
    if grep -qi microsoft /proc/version 2>/dev/null; then
      echo -e "${RED}[!] WSL is not supported yet.${NC}"
      echo "    Follow progress at: https://github.com/RisorseArtificiali/lince/issues/356"
      exit 1
    fi
    echo -e "${GREEN}[*] Platform: Linux ($ARCH)${NC}"
    ;;
  Darwin)
    echo -e "${YELLOW}[*] Platform: macOS ($ARCH) — experimental support${NC}"
    echo "    Sandbox via the native Seatbelt backend (sandbox-exec, built into macOS)."
    echo "    The legacy nono backend is deprecated. Some features may need validation."
    echo "    See: https://github.com/RisorseArtificiali/lince/issues/19"
    ;;
  *)
    echo -e "${RED}[!] Unsupported OS: $OS_NAME${NC}"
    echo "    LINCE currently supports Linux and macOS."
    echo "    Windows: https://github.com/RisorseArtificiali/lince/issues/22"
    exit 1
    ;;
esac
echo ""

# ── Helper functions ─────────────────────────────────────────────────
check_cmd() {
  command -v "$1" >/dev/null 2>&1
}

python_version() {
  "$1" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null
}

python_is_compatible() {
  python_version "$1" | awk '
    /^[0-9]+\.[0-9]+$/ {
      split($0, v, ".")
      ok = (v[1] > 3 || (v[1] == 3 && v[2] >= 11))
    }
    END { exit !ok }
  '
}

verify_sha256() {
  local archive="$1"
  local expected="$2"
  if check_cmd sha256sum; then
    printf '%s  %s\n' "$expected" "$archive" | sha256sum --check --status -
  elif check_cmd shasum; then
    printf '%s  %s\n' "$expected" "$archive" | shasum -a 256 --check - >/dev/null
  else
    echo -e "${RED}[!] Cannot verify downloads: sha256sum or shasum is required.${NC}" >&2
    return 1
  fi
}

download_verified() {
  local url="$1"
  local expected="$2"
  local destination="$3"
  if ! curl --fail --location --silent --show-error --output "$destination" "$url"; then
    echo -e "${RED}[!] Download failed: $url${NC}" >&2
    return 1
  fi
  if ! verify_sha256 "$destination" "$expected"; then
    echo -e "${RED}[!] Download checksum verification failed: $url${NC}" >&2
    return 1
  fi
}

ZELLIJ_VERSION="0.45.1"
PYTHON_VERSION="3.11.16"
PYTHON_RELEASE="20260901"
ZELLIJ_TARGET=""
ZELLIJ_SHA256=""
PYTHON_TARGET=""
PYTHON_SHA256=""

select_assets() {
  case "$OS_NAME:$ARCH" in
    Linux:x86_64|Linux:amd64)
      ZELLIJ_TARGET="x86_64-unknown-linux-musl"
      ZELLIJ_SHA256="40bcc2e03f5d5ae8e054e39f676081fe12ab70871506996ba595834c3718eefc"
      PYTHON_TARGET="x86_64-unknown-linux-gnu"
      PYTHON_SHA256="faa0758583a63f14c5eee516af82738403b59c13edda6fc0a21d953febd89eed"
      ;;
    Linux:aarch64|Linux:arm64)
      ZELLIJ_TARGET="aarch64-unknown-linux-musl"
      ZELLIJ_SHA256="05f0802afadd53f8db9514e7cae53c9ae8432fed1b35b8294aa816ee3044a16b"
      PYTHON_TARGET="aarch64-unknown-linux-gnu"
      PYTHON_SHA256="c1cca4af741e33d47871b298842e6c3272cd9e8f57daf8085359fcbfe2d1a5aa"
      ;;
    Darwin:x86_64|Darwin:amd64)
      ZELLIJ_TARGET="x86_64-apple-darwin"
      ZELLIJ_SHA256="8e8bea22737d1652278c51fc5c26c7c22c9855d0ebb9634a84b8873823093114"
      PYTHON_TARGET="x86_64-apple-darwin"
      PYTHON_SHA256="167cc15cf4eeb72944a67bbd2f7120c45fded17d5043d5db64b3144d7adc30ae"
      ;;
    Darwin:aarch64|Darwin:arm64)
      ZELLIJ_TARGET="aarch64-apple-darwin"
      ZELLIJ_SHA256="c029ba4fe1927b79ad9f0cdd59155c4dff80777863c85857d4d09b88b56f9891"
      PYTHON_TARGET="aarch64-apple-darwin"
      PYTHON_SHA256="50424fa409e8ae84b82a3052522f64695b47dff2158b70bb7358e0ebd6c085c9"
      ;;
    *)
      echo -e "${RED}[!] Unsupported architecture: $OS_NAME $ARCH${NC}" >&2
      exit 1
      ;;
  esac
}

provision_python() {
  local python_root="$HOME/.local/share/lince/python"
  local url="https://github.com/astral-sh/python-build-standalone/releases/download/${PYTHON_RELEASE}/cpython-${PYTHON_VERSION}%2B${PYTHON_RELEASE}-${PYTHON_TARGET}-install_only.tar.gz"
  local work_dir archive extracted new_root
  work_dir=$(mktemp -d "${TMPDIR:-/tmp}/lince-python.XXXXXX")
  archive="$work_dir/python.tar.gz"
  extracted="$work_dir/extracted"
  new_root="${python_root}.new"
  mkdir -p "$extracted" "$HOME/.local/share/lince"
  if ! download_verified "$url" "$PYTHON_SHA256" "$archive" ||
     ! tar -xzf "$archive" -C "$extracted" ||
     [ ! -x "$extracted/python/bin/python3" ]; then
    rm -rf "$work_dir" "$new_root"
    echo -e "${RED}[!] Could not provision standalone Python.${NC}" >&2
    return 1
  fi
  rm -rf "$new_root"
  mv "$extracted/python" "$new_root"
  rm -rf "$python_root"
  mv "$new_root" "$python_root"
  rm -rf "$work_dir"
}

provision_zellij() {
  local url="https://github.com/zellij-org/zellij/releases/download/v${ZELLIJ_VERSION}/zellij-${ZELLIJ_TARGET}.tar.gz"
  local work_dir archive extracted staged destination
  work_dir=$(mktemp -d "${TMPDIR:-/tmp}/lince-zellij.XXXXXX")
  archive="$work_dir/zellij.tar.gz"
  extracted="$work_dir/extracted"
  destination="$HOME/.local/bin/zellij"
  staged="$HOME/.local/bin/.zellij.new.$$"
  mkdir -p "$extracted" "$HOME/.local/bin"
  if ! download_verified "$url" "$ZELLIJ_SHA256" "$archive" ||
     ! tar -xzf "$archive" -C "$extracted" ||
     [ ! -f "$extracted/zellij" ]; then
    rm -rf "$work_dir"
    rm -f "$staged"
    echo -e "${RED}[!] Could not provision Zellij.${NC}" >&2
    return 1
  fi
  mv "$extracted/zellij" "$staged"
  chmod 755 "$staged"
  mv "$staged" "$destination"
  rm -rf "$work_dir"
}

# ── Prerequisites ────────────────────────────────────────────────────
echo -e "${BLUE}[1/2] Checking prerequisites...${NC}"

MISSING=()

# Core prerequisites that cannot be safely provisioned by this script.
for core_command in curl git; do
  if check_cmd "$core_command"; then
    echo -e "  ${GREEN}✓${NC} $core_command"
  else
    MISSING+=("$core_command")
    echo -e "  ${YELLOW}✗${NC} $core_command not found"
  fi
done

if [ "$OS_NAME" = "Linux" ]; then
  if check_cmd bwrap; then
    echo -e "  ${GREEN}✓${NC} bubblewrap"
  else
    MISSING+=("bubblewrap")
    echo -e "  ${YELLOW}✗${NC} bubblewrap not found"
    echo "    Install: sudo dnf install bubblewrap  (or: sudo apt install bubblewrap)"
  fi
elif check_cmd sandbox-exec; then
  echo -e "  ${GREEN}✓${NC} Seatbelt backend (sandbox-exec, built-in)"
else
  MISSING+=("macOS with sandbox-exec support")
  echo -e "  ${YELLOW}✗${NC} sandbox-exec not found"
fi

if [ ${#MISSING[@]} -gt 0 ]; then
  echo -e "${YELLOW}Missing core prerequisites:${NC}"
  for missing in "${MISSING[@]}"; do echo "  - $missing"; done
  exit 1
fi

select_assets

# Python 3.11+: prefer a compatible system interpreter, then the persistent
# standalone interpreter, and download only when neither is usable.
PYTHON_ROOT="$HOME/.local/share/lince/python"
if check_cmd python3 && python_is_compatible "$(command -v python3)"; then
  PYTHON_CMD="$(command -v python3)"
  echo -e "  ${GREEN}✓${NC} Python $(python_version "$PYTHON_CMD") (system)"
elif [ -x "$PYTHON_ROOT/bin/python3" ] && python_is_compatible "$PYTHON_ROOT/bin/python3"; then
  export PATH="$PYTHON_ROOT/bin:$PATH"
  PYTHON_CMD="$PYTHON_ROOT/bin/python3"
  echo -e "  ${GREEN}✓${NC} Python $(python_version "$PYTHON_CMD") (LINCE standalone)"
else
  echo -e "  ${YELLOW}→${NC} Provisioning standalone Python $PYTHON_VERSION..."
  provision_python
  export PATH="$PYTHON_ROOT/bin:$PATH"
  PYTHON_CMD="$PYTHON_ROOT/bin/python3"
  if ! python_is_compatible "$PYTHON_CMD"; then
    echo -e "${RED}[!] Provisioned Python failed the 3.11+ version check.${NC}" >&2
    exit 1
  fi
  echo -e "  ${GREEN}✓${NC} Python $(python_version "$PYTHON_CMD") (LINCE standalone)"
fi

# Zellij — standalone bootstrap, before the repository is available.
check_zellij_version() {
    local detected
    detected=$(zellij --version 2>/dev/null) || detected="unavailable"
    if printf '%s\n' "$detected" | awk '
        /^zellij [0-9]+\.[0-9]+\.[0-9]+$/ {
            split($2, v, ".")
            ok = (v[1] > 0 || v[2] > 45 || (v[2] == 45 && v[3] >= 1))
        }
        END { exit !ok }
    '; then
        printf '%s\n' "$detected"
        return 0
    fi
    printf 'Zellij >= 0.45.1 required for reliable Codex scrollback (found: %s).\n' "$detected" >&2
    printf 'Install/upgrade: https://github.com/zellij-org/zellij/releases (then restart Zellij).\n' >&2
    return 1
}
if ! check_zellij_version >/dev/null 2>&1; then
  echo -e "  ${YELLOW}→${NC} Provisioning Zellij $ZELLIJ_VERSION..."
  provision_zellij
fi
if ! ZELLIJ_DETECTED=$(check_zellij_version); then
  exit 1
fi
echo -e "  ${GREEN}✓${NC} $ZELLIJ_DETECTED"

# Agent-specific tools are warnings only.
if check_cmd node; then
  echo -e "  ${GREEN}✓${NC} node $(node --version 2>/dev/null)"
else
  echo -e "  ${YELLOW}⚠${NC} node not found; npm-installed agents will be unavailable"
fi

if check_cmd jq; then
  echo -e "  ${GREEN}✓${NC} jq"
else
  echo -e "  ${YELLOW}⚠${NC} jq not found; continuing without it"
fi

# Source-build tools are required only on explicit opt-in.
MISSING=()
if [ "$BUILD_FROM_SOURCE" = true ]; then
  if check_cmd rustup; then
    echo -e "  ${GREEN}✓${NC} rustup (source build)"
  else
    MISSING+=("rustup")
  fi
  if check_cmd cc; then
    echo -e "  ${GREEN}✓${NC} C compiler/linker (cc) (source build)"
  else
    MISSING+=("C compiler/linker (cc)")
  fi
fi

echo ""

if [ ${#MISSING[@]} -gt 0 ]; then
  echo -e "${YELLOW}Missing --build-from-source prerequisites:${NC}"
  for m in "${MISSING[@]}"; do
    echo "  - $m"
  done
  echo ""
  echo "Install the missing build tools or omit --build-from-source."
  exit 1
fi

# ── Clone / update LINCE ─────────────────────────────────────────────
LINCE_DATA_DIR="$HOME/.local/share/lince"
BOOTSTRAP_DIR="$LINCE_DATA_DIR/bootstrap-source"

echo -e "${BLUE}[2/2] Fetching LINCE...${NC}"

if [ -d "$BOOTSTRAP_DIR" ]; then
  echo -e "  ${DIM}Removing previous bootstrap clone at $BOOTSTRAP_DIR...${NC}"
  rm -rf "$BOOTSTRAP_DIR"
fi
mkdir -p "$LINCE_DATA_DIR"
echo "  Cloning to $BOOTSTRAP_DIR..."
git clone https://github.com/RisorseArtificiali/lince.git "$BOOTSTRAP_DIR"
echo ""

# ── Delegate to quickstart.sh ────────────────────────────────────────
QUICKSTART="$BOOTSTRAP_DIR/quickstart.sh"

if [ ! -f "$QUICKSTART" ]; then
  echo -e "${RED}[!] quickstart.sh not found at $QUICKSTART${NC}"
  echo "    The bootstrap clone may be incomplete. Try removing $BOOTSTRAP_DIR and re-running."
  exit 1
fi

echo -e "${CYAN}Handing off to quickstart.sh...${NC}"
echo ""

# When piped through curl | bash, stdin is the script itself, not the
# terminal. We need to give quickstart.sh access to the real terminal
# for interactive prompts.
#
# After successful installation, clean up the temporary clone.
cleanup_clone() {
  if [ -d "$BOOTSTRAP_DIR" ]; then
    echo ""
    echo -e "${DIM}Cleaning up temporary clone ($BOOTSTRAP_DIR)...${NC}"
    rm -rf "$BOOTSTRAP_DIR"
  fi
}

if [ "$USE_DEFAULTS" = true ] || [ -t 0 ]; then
  # Already running in a terminal — just exec (can't cleanup after exec)
  bash "$QUICKSTART" "$@" && cleanup_clone
else
  # Piped (curl | bash) — run quickstart with stdin from /dev/tty
  bash "$QUICKSTART" "$@" < /dev/tty && cleanup_clone
fi

#!/bin/sh
# Shell-independent entrypoint for the LINCE dashboard.
set -eu

bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "${1:-}" = "update" ]; then
    shift
    if [ ! -x "$bin_dir/lince-update" ]; then
        echo "lince: updater is not installed; re-run the LINCE installer" >&2
        exit 1
    fi
    exec "$bin_dir/lince-update" "$@"
fi
exec "$bin_dir/lince-dashboard-launch" "$@"

// Compatibility layout: VoxCode uses Alt+v and the status bar.
// No dedicated voice process is started. The launcher removes the auxiliary
// sidebar shell when dashboard.voxcode_enabled is true.

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="dashboard" {
        pane split_direction="horizontal" {
            pane size="60%" name="lince-controller" {
                plugin location="file:~/.config/zellij/plugins/lince-dashboard.wasm" {
                    config_path "~/.config/lince-dashboard/config.toml"
                }
            }
            pane {
            }
        }
    }
}

#!/usr/bin/env python3
"""Observe Codex's initial empty composer once, then defer to its native hooks."""
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import threading
import time

STARTING = "codex.Starting"
READY = "codex.PromptReady"


def prompt_ready(screen):
    # Match the empty composer from Codex 0.155.1, after the loading header
    # has resolved. Only infer startup readiness; native events own later turns.
    lines = [line.strip() for line in screen.splitlines()]
    if not any("OpenAI Codex" in line for line in lines):
        return False
    if not any(re.search(r"model:\s+(?!loading\b)\S+", line) for line in lines):
        return False
    if any(marker in screen.lower() for marker in (
        "esc to interrupt", "starting mcp", "booting mcp", "loading", "sign in",
        "trust this", "would you like", "press enter", "select a model", "shutting down",
    )):
        return False
    # The status line is user-configurable and may wrap or be clipped in a
    # narrow pane. The resolved header plus the exact empty composer are the
    # stable readiness signals; transient screens are excluded above.
    return "› Ask Codex to do anything" in lines


def observe(child, status, session, pane, stop):
    while not stop.wait(0.5) and child.poll() is None:
        try:
            if status.read_text().strip() != STARTING:
                return  # First native hook wins; never infer subsequent idle states.
            result = subprocess.run(["zellij", "-s", session, "action", "dump-screen", "--pane-id", pane],
                                    capture_output=True, text=True, timeout=2)
            if result.returncode or not prompt_ready(result.stdout):
                continue
            # Hook writes use the same lock directory, preventing a startup
            # observation from overwriting a concurrently arriving running event.
            lock = status.with_suffix(".startup-lock")
            try:
                lock.symlink_to(str(os.getpid()))
            except FileExistsError:
                # A killed prior observer/hook must not strand a reused agent
                # ID in Starting forever. Only reclaim the exact symlink value
                # we inspected, so a concurrent new owner is never removed.
                try:
                    if lock.is_dir() and not lock.is_symlink():
                        # Upgrade compatibility with the old mkdir lock. Its
                        # critical section was a single state read/write; use
                        # the shell hook's same three-second grace period.
                        if time.time() - lock.stat().st_mtime >= 3:
                            lock.rmdir()
                        continue
                    owner = os.readlink(lock)
                    if owner.isdecimal():
                        try:
                            os.kill(int(owner), 0)
                        except ProcessLookupError:
                            if os.readlink(lock) == owner:
                                lock.unlink(missing_ok=True)
                except OSError:
                    pass
                continue
            try:
                if child.poll() is None and status.read_text().strip() == STARTING:
                    status.write_text(READY + "\n")
            finally:
                lock.unlink(missing_ok=True)
            return
        except (OSError, subprocess.TimeoutExpired):
            continue


def main():
    command = sys.argv[1:]
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        return 2
    agent_id = os.environ.get("LINCE_AGENT_ID", "")
    pane = os.environ.get("ZELLIJ_PANE_ID", "")
    session = os.environ.get("ZELLIJ_SESSION_NAME", "")
    if not re.fullmatch(r"[A-Za-z0-9_-]+", agent_id) or not pane.isdecimal() or not session:
        os.execvp(command[0], command)
    status = Path(os.environ.get("LINCE_STATUS_DIR", "/tmp/lince-dashboard")) / f"{agent_id}.state"
    try:
        status.parent.mkdir(parents=True, exist_ok=True)
        status.write_text(STARTING + "\n")  # Discard a prior pane's stale idle state.
    except OSError:
        os.execvp(command[0], command)
    child = subprocess.Popen(command)
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, lambda number, _frame: child.send_signal(number) if child.poll() is None else None)
    stop = threading.Event()
    watcher = threading.Thread(target=observe, args=(child, status, session, pane, stop), daemon=True)
    watcher.start()
    try:
        result = child.wait()
    finally:
        stop.set()
        watcher.join(timeout=3)
        try:
            status.write_text("stopped\n")
        except OSError:
            pass
    return result if result >= 0 else 128 - result


if __name__ == "__main__":
    raise SystemExit(main())
